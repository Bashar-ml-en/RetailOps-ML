# Comma-separated browser origins allowed to call the local FastAPI service.
RETAILOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RETAILOPS_ENABLE_CSV_INGESTION alone cannot activate customer ingestion.
# This release has no identity-provider adapter, so the connector remains
# hard-disabled even when the flag is true. Never place credentials, tokens,
# connection strings, or customer data in this file or source control.

# Local public-benchmark runtime. The source path is read only by the separate
# worker; it is never accepted from the browser. Leave it unset to verify the
# persisted INCONCLUSIVE source-not-configured path.
# RETAILOPS_RUNTIME_ROOT=C:\secure-local-path\retailops-runtime
# RETAILOPS_AUDIT_ROOT=C:\secure-local-path\retailops-audit
# RETAILOPS_PUBLIC_BENCHMARK_SOURCE_PATH=C:\secure-local-path\train.parquet

# Optional OpenAI Planner Copilot. Keep OPENAI_API_KEY in the user/deployment
# secret environment, never in this file. All gates must be explicit; otherwise
# the API returns a safe unavailable response and no provider request is sent.
# RETAILOPS_ENABLE_PLANNER_COPILOT=true
# RETAILOPS_OPENAI_MODEL=owner-approved-model-id
# RETAILOPS_COPILOT_OPERATOR_TOKEN=local-operator-secret
# RETAILOPS_COPILOT_PER_RUN_BUDGET_CENTS=0
# RETAILOPS_COPILOT_MONTHLY_BUDGET_CENTS=0
# RETAILOPS_COPILOT_MAX_OUTPUT_TOKENS=800
# RETAILOPS_COPILOT_MAX_TOOL_CALLS=3
# RETAILOPS_COPILOT_NO_PROVIDER_STORAGE_APPROVED=true
